{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests/**/*.ts"]
}
